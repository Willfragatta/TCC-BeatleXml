# Copie para .env se for rodar o Python na máquina, fora do Docker.
# O docker-compose já define estas variáveis dentro dos contêineres.
# Senhas abaixo são só da demonstração da banca. Não use em produção.

ENV=development
DATABASE_URL=postgresql://beatle:beatle@localhost:5432/beatle
SECRET_KEY_JWT=demonstracao-banca-beatlexml-2026-nao-usar-em-producao
SECRET_KEY_CERTIFICADOS=CCwBwredcB_cEfHR5GdpX79qjlxk5CY5cT_VzPROiQ4=
SITE_URL=http://localhost:8000
CONTATO_EMAIL=contato@localhost
EMPRESA_CIDADE=Palmas, PR

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=0
SMTP_FROM=noreply@localhost
SMTP_FROM_NAME=BeatleXML
MAIL_SUPORTE=contato@localhost

# reCAPTCHA v3 fica no código. Com a chave vazia e ENV=development, o formulário
# não é bloqueado e a banca funciona sem internet.
# Com internet, as chaves públicas de teste do Google podem ser usadas:
# RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Não preencher: a demonstração não envia dados ao Google Analytics.
GA_MEASUREMENT_ID=
